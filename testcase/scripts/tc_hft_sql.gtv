/ M1 — HFT operators via SQL (hft mode default, then full mode)
SELECT t, ofi(bid, ask, bid_sz, ask_sz, 100) OVER (ORDER BY t) FROM ticks;
SELECT * FROM pit(500);
SELECT * FROM wash(500);
SELECT count(*) FROM orders WHERE risk(price, qty, mid, smp);
SELECT sym, mp(bid_px, ask_px, bid_sz, ask_sz) FROM book WHERE level = 0;
ALTER SESSION SET sqlmode = full;
SELECT sym, order_book_imbalance(bid_sz, ask_sz) FROM book GROUP BY sym;
SELECT id FROM vector_search('songs', '0.1,0.1', 3);
ALTER SESSION SET sqlmode = hft;
quit
